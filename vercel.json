{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "env": {
    "NODE_ENV": "production",
    "APP_ID": "@app-id",
    "APP_SECRET": "@app-secret",
    "DATABASE_URL": "@database-url",
    "VITE_KIMI_AUTH_URL": "@vite-auth-url",
    "VITE_APP_ID": "@vite-app-id",
    "KIMI_AUTH_URL": "@kimi-auth-url",
    "KIMI_OPEN_URL": "@kimi-open-url",
    "OWNER_UNION_ID": "admin"
  },
  "regions": ["sfo1"],
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  }
}
