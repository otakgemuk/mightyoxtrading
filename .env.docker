# Docker Local Development Environment
NODE_ENV=development

# Database (Docker MySQL service)
DB_ROOT_PASSWORD=root_password
DB_NAME=prop_firms_db
DB_USER=prop_user
DB_PASSWORD=secure_password
DATABASE_URL=mysql://prop_user:secure_password@mysql:3306/prop_firms_db

# App Configuration
APP_ID=kimi-prop-firms-local
APP_SECRET=dev-secret-key-change-in-production

# Frontend (Local)
VITE_KIMI_AUTH_URL=http://localhost:5173
VITE_APP_ID=kimi-prop-firms-local

# Backend (Local)
KIMI_AUTH_URL=http://localhost:5173
KIMI_OPEN_URL=http://localhost:5173

# Admin
OWNER_UNION_ID=admin
